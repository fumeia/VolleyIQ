# Public hostname; Caddy fetches the HTTPS certificate automatically.
DOMAIN=volleyiq.mydomain.com
# Login password for the web app (required on a public server).
APP_PASSWORD=change-me
# Random strings: generate with `openssl rand -hex 32`
SESSION_SECRET=
WORKER_TOKEN=
# Max video upload size in MB
MAX_UPLOAD_MB=8192
# 1 = install jersey-number OCR (YOLO + EasyOCR, CPU). Bigger image, slower analysis.
VISION=0
# Contact detection sensitivity (higher finds more touches, also more false ones)
SENSITIVITY=1.0
# Optional: cookies.txt for yt-dlp if YouTube blocks your server IP (path inside the container, e.g. /data/cookies.txt)
YTDLP_COOKIES=
