# Login password for the website and the Android app (required on a public server).
APP_PASSWORD=change-me
# Random string: generate with `openssl rand -hex 32`
SESSION_SECRET=
# Local port your reverse proxy forwards to (bound to 127.0.0.1 only).
PORT=3080

# Optional AI features (hidden unless configured): "Scan match sheet" reads teams,
# rosters and set scores off a photo of the official sheet, and "Coach summary"
# writes EN/DE insights from the stats. Point it at ONE backend:
#
# A) A LiteLLM / OpenAI-compatible gateway (self-hosted or your organisation's). Pick a
#    vision-capable model name your gateway offers.
# LITELLM_BASE_URL=https://litellm.example.com
# LITELLM_API_KEY=sk-...
# LITELLM_MODEL=gpt-4o            # default model; must accept images for the scan
# Optional, one model per feature (names exactly as the gateway lists them):
# SCAN_MODEL=...                   # match-sheet scan: needs image input
# SUMMARY_MODEL=...                # coach summary: text only, a cheap model is enough
# TOUCH_MODEL=...                  # AI check of detected touches in Review: needs image input
#                                    (falls back to SCAN_MODEL, then LITELLM_MODEL)
# AI_DAILY_LIMIT=400               # at most this many AI touch checks per day (one per rally)
# AI_MAX_REQUEST_KB=700           # pictures per AI request are kept under this size; a rally with
#                                    more goes in several requests (gateways behind nginx refuse
#                                    requests over 1 MB unless configured otherwise)
# AI_MONTHLY_BUDGET=30             # your monthly AI credit, shown in the app as what is left. Only
#                                    needed when the gateway does not report a budget for the key
#                                    (LiteLLM does: /key/info); spend then comes from the costs the
#                                    gateway reports per call
# AI_CURRENCY=$                    # the unit the gateway counts spend in (LiteLLM: US dollars)
#
# B) Or the Anthropic API directly (a few cents per scan):
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-opus-5-5    # claude-haiku-5-5 is cheaper, weaker on handwriting

# Optional: "Check for updates" in the app's About page. The server looks up the newest
# APK in this repository's GitHub releases and passes it through to the phone.
# UPDATE_REPO=owner/VolleyIQ
# For a private repository: a fine-grained token with read-only access to it
# (GitHub > Settings > Developer settings > Fine-grained tokens > only this repository,
# permission "Contents: Read-only").
# UPDATE_GITHUB_TOKEN=github_pat_...

# --- Match videos in your own bucket (optional) ---
# An S3-compatible bucket (e.g. Hetzner Object Storage). The Android app uploads the video
# straight into it; the public Replays tab streams it with links that expire after 6 hours.
# No video passes through or stays on this server. Use a private bucket without dots in its name.
# S3_ENDPOINT=https://hel1.your-objectstorage.com
# S3_BUCKET=volleyiq-videos
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_REGION=hel1                  # optional: defaults to the endpoint's first part
