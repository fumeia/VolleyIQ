# Login password for the website and the Android app (required on a public server).
APP_PASSWORD=change-me
# Random string: generate with `openssl rand -hex 32`
SESSION_SECRET=
# Local port your reverse proxy forwards to (bound to 127.0.0.1 only).
PORT=3080

# Optional AI features (hidden unless configured): "Scan match sheet" reads teams,
# rosters and set scores off a photo of the official sheet, and "Coach summary"
# writes EN/DE insights from the stats. Point it at ONE backend:
#
# A) A LiteLLM / OpenAI-compatible gateway (self-hosted or your organisation's). Pick a
#    vision-capable model name your gateway offers.
# LITELLM_BASE_URL=https://litellm.example.com
# LITELLM_API_KEY=sk-...
# LITELLM_MODEL=gpt-4o            # default model; must accept images for the scan
# Optional, one model per feature (names exactly as the gateway lists them):
# SCAN_MODEL=...                   # match-sheet scan: needs image input
# SUMMARY_MODEL=...                # coach summary: text only, a cheap model is enough
# TOUCH_MODEL=...                  # AI check of detected touches in Review: needs image input
#                                    (falls back to SCAN_MODEL, then LITELLM_MODEL)
# AI_DAILY_LIMIT=400               # at most this many AI touch checks per day (one per rally)
#
# B) Or the Anthropic API directly (a few cents per scan):
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-opus-5-5    # claude-haiku-5-5 is cheaper, weaker on handwriting
