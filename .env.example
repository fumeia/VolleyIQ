# Login password for the website and the Android app (required on a public server).
APP_PASSWORD=change-me
# Random string: generate with `openssl rand -hex 32`
SESSION_SECRET=
# Local port your reverse proxy forwards to (bound to 127.0.0.1 only).
PORT=3080

# Optional: enable "Scan match sheet" (reads teams, rosters and set scores off a
# photo of the official sheet with a Claude vision model). Costs a few cents per
# scan on your Anthropic account. Leave blank to hide the feature.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-opus-5-5; claude-haiku-5-5 is cheaper but weaker on handwriting).
# VISION_MODEL=claude-opus-5-5
